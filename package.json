{
  "name": "@wicle/mutex",
  "version": "0.10.0",
  "description": "Async mutex and semaphore implementation for Node.js and browsers.",
  "keywords": [
    "mutex",
    "semaphore",
    "async",
    "promise",
    "await",
    "posix",
    "lock",
    "unlock",
    "post",
    "wait"
  ],
  "homepage": "https://github.com/shnam7/wicle-mutex#readme",
  "bugs": {
    "url": "https://github.com/shnam7/wicle-mutex/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shnam7/wicle-mutex"
  },
  "license": "MIT",
  "author": {
    "name": "Robin Nam",
    "email": "shnam7@gmail.com"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm run build --watch",
    "lint": "tsc --noEmit && biome check",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "clean": "rimraf ./dist ./coverage",
    "rebuild": "run-s clean build",
    "prepare-to-commit": "run-s rebuild lint test",
    "npm-dry-run": "npm publish --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "npm-run-all2": "^9.0.2",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.10.0"
}
