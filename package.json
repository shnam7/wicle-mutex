{
  "name": "@wicle/mutex",
  "version": "0.10.0",
  "description": "Async mutex and semaphore implementation for Node.js and browsers.",
  "keywords": [
    "mutex",
    "semaphore",
    "async",
    "promise",
    "await",
    "posix",
    "lock",
    "unlock",
    "post",
    "wait"
  ],
  "homepage": "https://github.com/shnam7/wicle-mutex#readme",
  "bugs": {
    "url": "https://github.com/shnam7/wicle-mutex/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shnam7/wicle-mutex"
  },
  "license": "MIT",
  "author": {
    "name": "Robin Nam",
    "email": "shnam7@gmail.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },

  "files": [
    "dist/**"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "bun run build --watch",
    "build": "bun ./build/build.ts",
    "lint": "biome check",
    "test": "bun test --coverage",
    "test:watch": "bun test --watch --coverage",
    "clean": "rimraf ./dist ./coverage",
    "rebuild": "run-s clean build",
    "prepare-to-commit": "run-s rebuild lint test",
    "npm-dry-run": "npm publish --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "bun-plugin-dtsx": "^0.10.6",
    "npm-run-all2": "^9.0.2",
    "rimraf": "^6.1.3"
  },
  "packageManager": "bun@1.3.14"
}
