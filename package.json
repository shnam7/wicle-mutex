{
  "name": "@wicle/mutex",
  "version": "0.10.1",
  "description": "Async mutex and semaphore implementation for Node.js and browsers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.mts"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build --watch",
    "build": "tsdown src/index.ts --format cjs,esm --dts",
    "lint": "bun --parallel lint:*",
    "lint:ts": "biome check",
    "lint:ts:types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "clean": "rimraf ./dist ./coverage",
    "rebuild": "bun run --sequential clean build",
    "prepare-to-commit": "bun run --sequential rebuild lint test clean",
    "npm-dry-run": "npm publish --dry-run"
  },
  "keywords": [
    "mutex",
    "semaphore",
    "async",
    "promise",
    "await",
    "posix",
    "lock",
    "unlock",
    "post",
    "wait"
  ],
  "homepage": "https://github.com/shnam7/wicle-mutex#readme",
  "bugs": {
    "url": "https://github.com/shnam7/wicle-mutex/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shnam7/wicle-mutex"
  },
  "license": "MIT",
  "author": {
    "name": "Robin Nam",
    "email": "shnam7@gmail.com"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "bun-plugin-dtsx": "^0.11.12",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "bun@1.4.2"
}
